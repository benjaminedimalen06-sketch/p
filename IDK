-- ✅ UIScale para pare-pareho ang laki sa PC at CP
local UIScale = Instance.new("UIScale")
UIScale.Name = "ResponsiveScale"
UIScale.Parent = ScreenGui

local BASE_VIEWPORT = Vector2.new(1280, 720)

local function updateUIScale()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize
    local scaleX = vp.X / BASE_VIEWPORT.X
    local scaleY = vp.Y / BASE_VIEWPORT.Y
    local s = math.min(scaleX, scaleY)
    s = math.clamp(s, 0.65, 1.15)
    UIScale.Scale = s

    -- ✅ I-update din ang Kido Hub SurfaceGui base sa viewport
    if kidoHubPart and kidoHubPart.Parent then
        local sg = kidoHubPart:FindFirstChild("ScriptAreaText")
        if sg then
            local inverseScale = math.clamp(1 / s, 0.85, 1.55)
            sg.PixelsPerStud = 50 * inverseScale
        end
    end
end

updateUIScale()

local function hookCamera()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateUIScale)
end

hookCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    task.wait(0.1)
    hookCamera()
    updateUIScale()
end)

