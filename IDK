local function FireProximityPromptSafe(prompt)
    if not prompt or not prompt.Parent then return false end
    local holdDur = prompt.HoldDuration or 0
    if holdDur <= 0 then holdDur = 0.1 end
    local fired = false
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
            fired = true
        end
    end)
    if fired then return true end
    local ok = pcall(function() prompt:InputHoldBegin() end)
    if not ok then return false end
    task.wait(holdDur + 0.05)
    pcall(function() prompt:InputHoldEnd() end)
    return true
end

local function FireAllPromptsNear(position, radius)
    radius = radius or 25
    local fired = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local ppPos = nil
            local parent = obj.Parent
            if parent then
                if parent:IsA("BasePart") then ppPos = parent.Position
                elseif parent:IsA("Model") and parent.PrimaryPart then ppPos = parent.PrimaryPart.Position
                end
            end
            if ppPos and (ppPos - position).Magnitude <= radius then
                FireProximityPromptSafe(obj)
                fired = fired + 1
            end
        end
    end
    return fired
end

local function HasActivePromptNear(position, radius)
    radius = radius or 25
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local ppPos = nil
            local parent = obj.Parent
            if parent then
                if parent:IsA("BasePart") then ppPos = parent.Position
                elseif parent:IsA("Model") and parent.PrimaryPart then ppPos = parent.PrimaryPart.Position
                end
            end
            if ppPos and (ppPos - position).Magnitude <= radius then
                return true
            end
        end
    end
    return false
end

