local function StealBestEgg(targetRecord)
    if CONFIG.isStealing then return false end
    CONFIG.isStealing = true

    local char = LP.Character
    if not char then CONFIG.isStealing = false return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then CONFIG.isStealing = false return false end
    local hrp = findHRP()
    if not hrp then CONFIG.isStealing = false return false end

    local targetUid = nil
    local finalTarget = nil

    if SELECTED_TARGET and SELECTED_TARGET.record and SELECTED_TARGET.record.Uid then
        targetUid = SELECTED_TARGET.record.Uid
        finalTarget = GetTargetRecord(targetUid) or SELECTED_TARGET.record
    else
        if not targetRecord then
            local sorted = GetSortedEggs()
            if #sorted > 0 then targetRecord = sorted[1].record end
        end
        finalTarget = targetRecord
        if finalTarget then targetUid = finalTarget.Uid end
    end

    if not finalTarget or not targetUid then
        CONFIG.isStealing = false
        return false
    end

    if LowEggArena and LowEggArena.Parent then
        TravelTo(LowEggArena.Position, CONFIG.travelSpeed)
        task.wait(0.3)
        FireAllPromptsNear(LowEggArena.Position, 25)

        local holdTimer = CONFIG.lowEggHoldTime
        local holdStart = os.clock()

        while (os.clock() - holdStart) < holdTimer do
            if not CONFIG.autoLoop then
                CONFIG.isStealing = false
                return false
            end

            local holding = HasActivePromptNear(LowEggArena.Position, 25)

            if holding then
                task.wait(0.1)
            else
                holdStart = os.clock()
                task.wait(0.1)
            end
        end

        task.wait(CONFIG.afterRateWait)
    end

    if not LP.Character or not LP.Character:FindFirstChildOfClass("Humanoid") or LP.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
        CONFIG.isStealing = false
        return false
    end

    local lastKnownCFrame = GetTargetPosition(targetUid)
    if not lastKnownCFrame then
        TAKEN_EGGS[targetUid] = true
        if listRows[targetUid] then
            listRows[targetUid]:Destroy()
            listRows[targetUid] = nil
        end
        CONFIG.isStealing = false
        return false
    end

    local liveRecord = FindEggByUid(targetUid)
    if liveRecord then finalTarget = liveRecord end

    TravelTo(lastKnownCFrame.Position, CONFIG.travelSpeed)
    task.wait(CONFIG.arriveDelay)

    local carried = false
    local waitStart = os.clock()

    while not carried do
        if not LP.Character or not LP.Character:FindFirstChildOfClass("Humanoid") or LP.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            CONFIG.isStealing = false
            return false
        end
        if not CONFIG.autoLoop then
            CONFIG.isStealing = false
            return false
        end

        CarryEgg(finalTarget)
        task.wait(CONFIG.carryCheckInterval)

        if IsEggCarried(targetUid) then
            carried = true
            break
        end

        local newPos = GetTargetPosition(targetUid)
        if newPos then
            local hrpNow = findHRP()
            if hrpNow then
                local dist = (hrpNow.Position - newPos.Position).Magnitude
                if dist > 5 then
                    TravelTo(newPos.Position, CONFIG.travelSpeed)
                end
            end
        end

        local fresh = FindEggByUid(targetUid)
        if fresh then finalTarget = fresh end

        if (os.clock() - waitStart) > CONFIG.maxStealWait then
            TAKEN_EGGS[targetUid] = true
            if listRows[targetUid] then
                listRows[targetUid]:Destroy()
                listRows[targetUid] = nil
            end

            CONFIG.isStealing = false
            task.wait(CONFIG.retryDelay)
            return false
        end
    end

    if carried then
        TAKEN_EGGS[targetUid] = true

        if TargetPanel then TargetPanel.Visible = false end

        task.spawn(function()
            task.wait(CONFIG.rowRemoveDelay)
            if listRows[targetUid] then
                listRows[targetUid]:Destroy()
                listRows[targetUid] = nil
            end
        end)

        AscendInstant(CONFIG.flyHeight)
        local currentPos = findHRP() and findHRP().Position or KIDO_HUB_POS
        local kidoHubHigh = Vector3.new(KIDO_HUB_POS.X, currentPos.Y, KIDO_HUB_POS.Z)
        TravelTo(kidoHubHigh, CONFIG.travelSpeed)
        TravelTo(KIDO_HUB_POS + Vector3.new(0, 3, 0), CONFIG.travelSpeed)

        local kidoHubAttempts = 0

        while CONFIG.autoLoop and kidoHubAttempts < CONFIG.kidoHubMaxRetries do
            kidoHubAttempts = kidoHubAttempts + 1

            local touchConfirmed = false
            local touchTimer = CONFIG.kidoHubWait
            local touchStart = os.clock()

            while (os.clock() - touchStart) < touchTimer do
                if not CONFIG.autoLoop then
                    CONFIG.isStealing = false
                    return false
                end

                if IsTouchingKidoHub() then
                    touchConfirmed = true
                    break
                end

                task.wait(0.05)
            end

            if touchConfirmed then
                if TargetPanel then TargetPanel.Visible = false end

                local stayStart = os.clock()
                while (os.clock() - stayStart) < CONFIG.kidoHubStayTime do
                    if not CONFIG.autoLoop then
                        CONFIG.isStealing = false
                        return false
                    end

                    local hrp = findHRP()
                    if hrp then
                        hrp.CFrame = CFrame.new(KIDO_HUB_POS + Vector3.new(0, 3, 0))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end

                    task.wait(0.05)
                end

                break
            else
                local eggPos = GetTargetPosition(targetUid)
                if eggPos then
                    TravelTo(eggPos.Position, CONFIG.travelSpeed)
                    task.wait(0.3)

                    CarryEgg(finalTarget)
                    task.wait(0.2)
                end

                AscendInstant(CONFIG.flyHeight)
                local nowPos = findHRP() and findHRP().Position or KIDO_HUB_POS
                local hubHigh = Vector3.new(KIDO_HUB_POS.X, nowPos.Y, KIDO_HUB_POS.Z)
                TravelTo(hubHigh, CONFIG.travelSpeed)
                TravelTo(KIDO_HUB_POS + Vector3.new(0, 3, 0), CONFIG.travelSpeed)

                task.wait(0.3)
            end
        end

        if kidoHubAttempts >= CONFIG.kidoHubMaxRetries then
            TAKEN_EGGS[targetUid] = true
            if listRows[targetUid] then
                listRows[targetUid]:Destroy()
                listRows[targetUid] = nil
            end

            CONFIG.isStealing = false
            StopAuto()
            return false
        end

        local partWaitStart = os.clock()
        while (os.clock() - partWaitStart) < CONFIG.partWaitTime do
            if not CONFIG.autoLoop then
                CONFIG.isStealing = false
                return false
            end

            local hrp = findHRP()
            if hrp then
                hrp.CFrame = CFrame.new(KIDO_HUB_POS + Vector3.new(0, 3, 0))
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end

            task.wait(0.05)
        end

        -- PART-3
        TravelTo(PART3_POS + Vector3.new(0, 5, 0), CONFIG.travelSpeed)
        task.wait(CONFIG.partTravelWait)
        local hrpP3 = findHRP()
        if hrpP3 then
            hrpP3.CFrame = CFrame.new(PART3_POS + Vector3.new(0, 5, 0))
            hrpP3.AssemblyLinearVelocity = Vector3.zero
            hrpP3.AssemblyAngularVelocity = Vector3.zero
        end
        task.wait(CONFIG.partTravelWait)

        -- PART-1
        TravelTo(PART1_POS + Vector3.new(0, 5, 0), CONFIG.travelSpeed)
        task.wait(CONFIG.partTravelWait)
        local hrpP1 = findHRP()
        if hrpP1 then
            hrpP1.CFrame = CFrame.new(PART1_POS + Vector3.new(0, 5, 0))
            hrpP1.AssemblyLinearVelocity = Vector3.zero
            hrpP1.AssemblyAngularVelocity = Vector3.zero
        end
        task.wait(CONFIG.partTravelWait)

        -- PART-2
        TravelTo(PART2_POS + Vector3.new(0, 5, 0), CONFIG.travelSpeed)
        task.wait(CONFIG.partTravelWait)
        local hrpP2 = findHRP()
        if hrpP2 then
            hrpP2.CFrame = CFrame.new(PART2_POS + Vector3.new(0, 5, 0))
            hrpP2.AssemblyLinearVelocity = Vector3.zero
            hrpP2.AssemblyAngularVelocity = Vector3.zero
        end
        task.wait(CONFIG.partFinalWait)

        CONFIG.isStealing = false
        return true
    end

    CONFIG.isStealing = false
    return false
end

