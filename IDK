-- ==============================================================================
local function findHRP()
    local ch = LP.Character
    if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
end

local function GetAssetsInfo(egg)
    if not egg or not AssetsData then return nil end
    local dir = AssetsData.Directory or AssetsData
    local cat = tostring(egg.AssetCategory or egg.Category or egg.Name or "")
    if dir[cat] then return dir[cat] end
    return nil
end

local function GetEggRarityInfo(egg)
    if not egg then return "Common" end
    if egg.AreaId then return tostring(egg.AreaId) end
    return "Common"
end

local function GetEggValueRaw(egg)
    if not egg then return 0 end
    local info = GetAssetsInfo(egg)
    if not info then return 0 end
    local er = tonumber(info.EarningRate) or 0
    local scale = tonumber(egg.AssetScale) or 1
    if scale <= 0 then scale = 1 end
    return er * scale * 0.893
end

local function GetEggSizeRaw(egg)
    if not egg then return 0 end
    if egg.AssetScale then return tonumber(egg.AssetScale) or 0 end
    return 0
end

local function FormatSize(s)
    if not s or s == 0 then return "0.00x" end
    return string.format("%.2fx", s)
end

local function GetEggThumbnail(egg)
    if not egg then return nil end
    if egg.Thumbnail and type(egg.Thumbnail) == "string" then return egg.Thumbnail end
    local info = GetAssetsInfo(egg)
    if info and info.Icon then return info.Icon end
    return nil
end

local function GetSortedEggs()
    local list = {}
    if EggState and EggState.ReadFieldEggs then
        local ok, snap = pcall(EggState.ReadFieldEggs)
        if ok and snap and snap.Records then
            for _, egg in ipairs(snap.Records) do
                if egg.State == "Slot" and egg.BoundsCFrame and egg.Uid then
                    if not TAKEN_EGGS[egg.Uid] then
                        EGG_CACHE[egg.Uid] = {
                            record = egg,
                            score = GetEggValueRaw(egg),
                            rarity = GetEggRarityInfo(egg),
                            size = GetEggSizeRaw(egg),
                            thumb = GetEggThumbnail(egg),
                            lastCFrame = egg.BoundsCFrame,
                        }
                        table.insert(list, EGG_CACHE[egg.Uid])
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.score > b.score end)
    return list
end

local function IsEggCarried(eggUid)
    if not eggUid then return false end
    if not EggState or not EggState.ReadFieldEggs then return false end
    local ok, snap = pcall(EggState.ReadFieldEggs)
    if not ok or not snap or not snap.Records then return false end
    for _, r in ipairs(snap.Records) do
        if r.Uid == eggUid then
            if r.State == "Carried" or r.State == "Carry" then
                return true
            end
            return false
        end
    end
    return false
end

local function FindEggByUid(uid)
    if not uid then return nil end
    if not EggState or not EggState.ReadFieldEggs then return nil end
    local ok, snap = pcall(EggState.ReadFieldEggs)
    if not ok or not snap or not snap.Records then return nil end
    for _, r in ipairs(snap.Records) do
        if r.Uid == uid then return r end
    end
    return nil
end

local function GetTargetRecord(uid)
    if not uid then return nil end
    local fresh = FindEggByUid(uid)
    if fresh then return fresh end
    if EGG_CACHE[uid] then return EGG_CACHE[uid].record end
    if SELECTED_TARGET and SELECTED_TARGET.record and SELECTED_TARGET.record.Uid == uid then
        return SELECTED_TARGET.record
    end
    return nil
end

local function GetTargetPosition(uid)
    if not uid then return nil end
    local fresh = FindEggByUid(uid)
    if fresh and fresh.BoundsCFrame then return fresh.BoundsCFrame end
    if EGG_CACHE[uid] and EGG_CACHE[uid].lastCFrame then return EGG_CACHE[uid].lastCFrame end
    if SELECTED_TARGET and SELECTED_TARGET.record and SELECTED_TARGET.record.Uid == uid then
        return SELECTED_TARGET.record.BoundsCFrame
    end
    return nil
end

