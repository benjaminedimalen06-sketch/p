-- ==============================================================================
-- TRAVEL
-- ==============================================================================
local function TravelTo(targetPos, speed)
    local hrp = findHRP()
    if not hrp or not targetPos then return false end
    local start = hrp.Position
    local dist = (targetPos - start).Magnitude
    if dist < 1.5 then return true end
    speed = math.clamp(tonumber(speed) or CONFIG.travelSpeed, 50, 2000)
    local moveTime = math.max(dist / speed, 0.02)
    local t0 = os.clock()
    while os.clock() - t0 < moveTime do
        RunService.Heartbeat:Wait()
        local char = LP.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local a = math.clamp((os.clock() - t0) / moveTime, 0, 1)
        local cur = start:Lerp(targetPos, a)
        local delta = targetPos - start
        local lookDir = delta.Magnitude > 0.001 and delta.Unit or Vector3.new(1, 0, 0)
        hrp.CFrame = CFrame.lookAt(cur, cur + lookDir)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    hrp.CFrame = CFrame.new(targetPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function AscendInstant(height)
    local hrp = findHRP()
    if not hrp then return false end
    local upPos = hrp.Position + Vector3.new(0, height, 0)
    hrp.CFrame = CFrame.new(upPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    return true
end

local function IsTouchingKidoHub()
    local hrp = findHRP()
    if not hrp then return false end
    local dist = (hrp.Position - KIDO_HUB_POS).Magnitude
    return dist <= CONFIG.kidoHubTouchRadius
end

