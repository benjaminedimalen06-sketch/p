local function BuildList()
    local sorted = GetSortedEggs()

    for order, entry in ipairs(sorted) do
        local uid = entry.record.Uid
        if not listRows[uid] or not listRows[uid].Parent then
            local row = CreateEggRow(entry, order)
            listRows[uid] = row
        else
            listRows[uid].LayoutOrder = order
        end
    end

    for uid, row in pairs(listRows) do
        if not TAKEN_EGGS[uid] then
            local stillThere = false
            for _, entry in ipairs(sorted) do
                if entry.record.Uid == uid then
                    stillThere = true
                    break
                end
            end
            if not stillThere then
                row:Destroy()
                listRows[uid] = nil
            end
        else
            row:Destroy()
            listRows[uid] = nil
        end
    end
end

