-- ==============================================================================
local function CarryEgg(record)
    if not record or not record.Uid then return false end
    local slotKey = nil
    if record.AreaId and record.NestId then
        slotKey = record.AreaId .. ":" .. record.NestId
    end
    local success = false
    pcall(function()
        if EggState and EggState.CarryFieldEgg then
            EggState.CarryFieldEgg(record.Uid, slotKey)
            success = true
        end
    end)
    if not success then
        pcall(function()
            if EggState and EggState.CarryFieldEgg then
                EggState.CarryFieldEgg(slotKey, record.Uid)
                success = true
            end
        end)
    end
    if not success then
        pcall(function()
            if EggState and EggState.CarryFieldEgg then
                EggState.CarryFieldEgg(record)
                success = true
            end
        end)
    end
    return success
end

