-- ==============================================================================
-- AUTO JUMP
-- ==============================================================================
local spaceHeld = false
local jumpThread = nil

local function getRealHumanoid(char)
    if not char then return nil end
    local renamed = char:FindFirstChild("1")
    if renamed and renamed:IsA("Humanoid") then return renamed end
    return char:FindFirstChildOfClass("Humanoid")
end

local function startAutoJump()
    if jumpThread then
        pcall(function() task.cancel(jumpThread) end)
        jumpThread = nil
    end
    jumpThread = task.spawn(function()
        while spaceHeld and CONFIG.autoJumpEnabled do
            local char = LP.Character
            if char then
                local hum = getRealHumanoid(char)
                if hum and hum.Health > 0 then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    pcall(function() hum.Jump = true end)
                end
            end
            task.wait(CONFIG.jumpInterval)
        end
        jumpThread = nil
    end)
end

local function stopAutoJump()
    if jumpThread then
        pcall(function() task.cancel(jumpThread) end)
        jumpThread = nil
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Space then
        spaceHeld = true
        startAutoJump()
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.Space then
        spaceHeld = false
        stopAutoJump()
    end
end)

